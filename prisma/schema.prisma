generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NoteLinkTargetType {
  NOTE
  TERM
  SNIPPET
  PROJECT
  UNKNOWN
}

model Term {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  sourceUrl   String?
  aiSummary   String?
  tags        String   @default("")
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, userId])
  @@index([userId, deletedAt, createdAt])
}

model Snippet {
  id          String   @id @default(cuid())
  userId      String
  title       String
  code        String
  language    String   @default("typescript")
  explanation String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, deletedAt, createdAt])
}

model ProjectAnalysis {
  id                String   @id @default(cuid())
  userId            String
  projectName       String
  directoryTree     String
  mermaidCode       String?
  workflowNotes     String?
  aiWorkflowSummary String?
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, deletedAt, createdAt])
}

model Note {
  id         String     @id @default(cuid())
  userId     String
  title      String
  content    String
  summary    String     @default("")
  tags       String     @default("")
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  links      NoteLink[]

  @@index([userId, deletedAt, createdAt])
  @@index([userId, title])
}

model NoteLink {
  id          String             @id @default(cuid())
  sourceNoteId String
  label       String
  targetType  NoteLinkTargetType
  targetId    String?
  createdAt   DateTime           @default(now())
  sourceNote  Note               @relation(fields: [sourceNoteId], references: [id], onDelete: Cascade)

  @@index([sourceNoteId])
  @@index([targetType, targetId])
}

model UserConfig {
  userId    String   @id
  provider  String   @default("zhipu")
  apiKey    String?
  baseURL   String?
  modelName String?
  updatedAt DateTime @updatedAt
}
